---
// Site header. The 💬 button is wired in Base.astro; a page says what it reports with onFeedback().
import { page } from '../lib/url';

interface Props { current: string }
const { current } = Astro.props;
const items: [string, string][] = [
  ['index', 'Overzicht'], ['tekens', 'Tekens'], ['verbindingen', 'Verbindingen'],
  ['proberen', 'Proberen'], ['schrijven', 'Woorden schrijven'], ['letters', 'Letters schrijven'],
];
---
<nav class="site-nav" aria-label="Website">
  <div class="in">
    <a class="brand" href={page('index')}>Cogncur <small>voor Google Fonts</small></a>
    <ul>
      {items.map(([id, label]) => (
        <li><a href={page(id)} aria-current={id === current ? 'page' : undefined}>{label}</a></li>
      ))}
    </ul>
    <button type="button" class="fb-btn" id="fb-nav">💬 Feedback</button>
  </div>
</nav>
