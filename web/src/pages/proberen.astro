---
// The original Cogncur and the new version on the same writing lines (formerly tools/live.html),
// overlaid or stacked, with every OpenType feature and a shareable config code.
import Base from '../layouts/Base.astro';
import { FEATURES, GROUPS, cssFeatures, defaults } from '../lib/features';

const DEFAULTS = defaults();
// The feature table: left = this feature off, right = on (plus what it needs), the rest default.
const rowsByGroup = GROUPS.map((g) => ({
  ...g,
  features: FEATURES.filter((f) => f.group === g.id).map((f) => {
    const before = { ...DEFAULTS, [f.tag]: false };
    const after = { ...DEFAULTS, [f.tag]: true };
    for (const n of f.needs ?? []) { before[n] = true; after[n] = true; }
    return { f, before: cssFeatures(before), after: cssFeatures(after) };
  }),
}));
const PRESETS: [string, string][] = [
  ['joins', 'Alle verbindingen'], ['caps', 'Hoofdletters'], ['accents', 'Accenten'],
  ['punct', 'Leestekens'], ['numbers', 'Cijfers'], ['newletters', 'Nieuwe letters'],
];
---
<Base title="Proberen · Cogncur" current="proberen"
      description="Typ je eigen tekst en vergelijk het originele Cogncur met de nieuwe versie, met alle lettervormen.">
  <div class="proberen">
    <div class="main">
      <main class="paper" id="paper" aria-label="Vergelijking">
        <div class="paper-inner">
          <div class="margin-rule"></div>
          <div id="rows"></div>
        </div>
      </main>

      <section class="features" aria-labelledby="feaTitle">
        <h2 id="feaTitle">Lettervormen kiezen</h2>
        <p class="intro">In Google Docs kan je deze opties niet aan- of uitzetten: wat standaard aan staat, krijgt iedereen. Zet aan wat jij standaard wilt, bekijk het resultaat op het blad hierboven, en deel je keuze met de code rechts.</p>
        <div class="table-wrap">
          <table class="fea">
            <thead><tr><th scope="col">Aan</th><th scope="col">Code</th><th scope="col">Wat verandert er?</th><th scope="col">Voorbeeld (zonder → met)</th></tr></thead>
            <tbody>
              {rowsByGroup.map((g) => (
                <>
                  <tr><th class="group" colspan="4" scope="colgroup">{g.title}{g.note && <small> · {g.note}</small>}</th></tr>
                  {g.features.map(({ f, before, after }) => (
                    <tr id={`row_${f.tag}`}>
                      <td class="tog"><input type="checkbox" id={`f_${f.tag}`} data-tag={f.tag} aria-label={f.name} checked={!!f.on}></td>
                      <td class="code"><code>{f.tag}</code></td>
                      <td class="what"><label for={`f_${f.tag}`}><strong>{f.name}</strong></label><span>{f.desc}</span>{f.warn && <em>{f.warn}</em>}</td>
                      <td class="ex">
                        <span class="sample" style={`font-feature-settings: ${before}${f.tag === 'kern' ? '; font-kerning: none' : ''}`}>{f.ex}</span>
                        <span class="arrow" aria-hidden="true">→</span>
                        <span class="sample after" style={`font-feature-settings: ${after}`}>{f.ex}</span>
                      </td>
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <aside class="panel" aria-label="Instellingen">
      <h1>Proberen</h1>
      <p class="sub">Het originele Cogncur en de nieuwe versie op dezelfde schrijflijnen.</p>

      <fieldset class="config">
        <legend>Jouw keuze als code</legend>
        <input type="text" class="code" id="cfgOut" readonly aria-label="Code van je huidige keuze">
        <div class="btns">
          <button type="button" class="primary" id="cfgCopy">Kopieer</button>
          <button type="button" id="cfgReset">Alles standaard</button>
        </div>
        <label for="cfgIn" style="display:block;margin-top:10px">Code plakken</label>
        <input type="text" class="code" id="cfgIn" placeholder="vtex: ss03 ss08" spellcheck="false">
        <div class="btns"><button type="button" id="cfgApply">Toepassen</button></div>
        <p class="status" id="cfgStatus" role="status"></p>
        <p class="hint">Plak de code in een reactie op GitHub, zodat anderen precies jouw keuze kunnen bekijken.</p>
      </fieldset>

      <fieldset>
        <legend><label for="text">Tekst</label></legend>
        <textarea id="text" spellcheck="false">Leren schrijven in de klas
toot puddle yummy wow
Amsterdam bijzonder (hallo)</textarea>
        <div class="presets" aria-label="Voorbeeldteksten">
          {PRESETS.map(([id, label]) => <button type="button" data-preset={id}>{label}</button>)}
        </div>
      </fieldset>

      <fieldset>
        <legend>Weergave</legend>
        <div class="seg" role="radiogroup">
          <input type="radio" name="view" id="vOverlay" value="overlay" checked><label for="vOverlay">Over elkaar</label>
          <input type="radio" name="view" id="vStack" value="stack"><label for="vStack">Onder elkaar</label>
        </div>
      </fieldset>

      <fieldset>
        <legend><label for="size">Grootte</label></legend>
        <div class="range"><input type="range" id="size" min="30" max="358" step="4" value="110"><output for="size" id="sizeOut">110 px</output></div>
      </fieldset>

      <fieldset>
        <legend>Lettertypes</legend>
        <div class="font-ctl" id="ctlOrig" style="--swatch: #1E4FB8">
          <div class="top">
            <label class="check"><input type="checkbox" id="showOrig" checked> <strong>Origineel (Cogncur)</strong></label>
            <input type="color" id="colOrig" value="#1E4FB8" aria-label="Kleur van het origineel">
          </div>
          <div class="range"><input type="range" id="opOrig" min="0" max="100" value="70" aria-label="Doorzichtigheid van het origineel"><output id="opOrigOut">70%</output></div>
        </div>
        <div class="font-ctl" id="ctlNew" style="--swatch: #D1203B">
          <div class="top">
            <label class="check"><input type="checkbox" id="showNew" checked> <strong>Nieuwe versie</strong></label>
            <input type="color" id="colNew" value="#D1203B" aria-label="Kleur van de nieuwe versie">
          </div>
          <div class="range"><input type="range" id="opNew" min="0" max="100" value="70" aria-label="Doorzichtigheid van de nieuwe versie"><output id="opNewOut">70%</output></div>
        </div>
        <label class="check"><input type="checkbox" id="blend" checked> Donkerder waar ze overlappen</label>
        <label class="check"><input type="checkbox" id="guides" checked> Schrijflijnen</label>
        <label class="check"><input type="checkbox" id="ghost" checked> Bij nieuwe letters de basisletter tonen in het origineel</label>
      </fieldset>

      <p class="note">Beide lettertypes krijgen hier dezelfde regelhoogte, zodat de basislijnen samenvallen. Verschillen in regelafstand tussen de bestanden zie je op deze pagina dus niet.</p>
    </aside>
  </div>
</Base>

<script>
  import { FEATURES, cssFeatures, decode, defaults, encode, linkCode, warnings, type FeatureState } from '../lib/features';
  import { ASC, ASCENDER, DESC, DESCENDER, UPM, XH, loadFont } from '../lib/font';
  import { renderLines } from '../lib/sheet';
  import { versionText } from '../lib/build';
  import { onFeedback, publicLink } from '../lib/feedback';
  import composites from '../../public/data/composites.json';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const paper = $('paper'), rows = $('rows'), text = $<HTMLTextAreaElement>('text');
  const DEFAULTS = defaults();
  const state: FeatureState = defaults();

  const PRESETS: Record<string, string> = {
    joins: 'abcdefghijklm\nnopqrstuvwxyz\naa ab ac ad ae af ag\nba bb bc bd be bf bg\nfa fb ff fi fj fo fz\nqa qu qz sa sb ss st',
    caps: 'Amsterdam Brugge Cindy\nDaan Emma Fien Gent\nHilde IJsland Jan Kim\nLeo Marie Nina Otto',
    accents: 'café naïve façade élève\ngeëerd reünie Noël\nšpička žena œuvre æble',
    punct: '(hallo) [test] "quote"\nword. word, word; word!\ndon\'t e-mail 1st 2024',
    numbers: '1234567890\n12 + 34 = 46\n2024 – 1789',
    newletters: 'Ćwierć źrebię Łódź\nż ą ę ł ő ű ș ț ģ ķ ļ ņ\nnćn nčn nğn nńn nňn nŕn nřn\nnśn nşn nźn ŵan ẃan ẅan\nnąn nęn nįn nųn nċn nėn nġn nżn\nnőn nűn nșn nțn nķn nļn nņn\nnďn nľn nťn nĺn nđn nħn nłn nðn nþn\nĆn Čn Ďn Ěn Ğn Ĺn Ńn Ňn Ŕn Řn\nŚn Şn Ťn Źn Ŵn Ỳn Ĩn Ǎn Ǐn Ǒn Ǔn\nĄn Ęn Įn Ųn Ċn Ėn Ġn Żn İn Őn Űn\nȘn Țn Ķn Ļn Ņn Ģn Ľn Đn Ðn Ħn Łn Þn ẞn\n¯ ˆ ˇ ˘ ˙ ˚ ˛ ˜ ˝ … 5−3',
  };

  // Letters added in the new build: the original font doesn't have them; optionally show their base letter there.
  const NEW_CHARS = new Set((composites as { char: string }[]).map((x) => x.char));
  const toBase = (line: string) => [...line].map((c) => (NEW_CHARS.has(c) ? c.normalize('NFD')[0] : c)).join('');

  const featureBoxes = [...document.querySelectorAll<HTMLInputElement>('.fea input[data-tag]')];
  function applyState(next: FeatureState) {
    Object.assign(state, next);
    for (const cb of featureBoxes) cb.checked = !!state[cb.dataset.tag!];
  }

  // ---------- persisted settings (per browser, best effort)
  const KEY = 'live-compare-v2';
  const controls = ['size', 'colOrig', 'colNew', 'opOrig', 'opNew'] as const;
  const checks = ['showOrig', 'showNew', 'blend', 'guides', 'ghost'] as const;
  function persist() {
    const data: Record<string, unknown> = { text: text.value, view: viewValue(), fea: state };
    for (const k of controls) data[k] = $<HTMLInputElement>(k).value;
    for (const k of checks) data[k] = $<HTMLInputElement>(k).checked;
    try { localStorage.setItem(KEY, JSON.stringify(data)); } catch { /* storage unavailable */ }
  }
  function restore() {
    let saved: Record<string, any> = {};
    try { saved = JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch { saved = {}; }
    if (typeof saved.text === 'string') text.value = saved.text;
    if (saved.view) document.querySelector<HTMLInputElement>(`input[name=view][value=${saved.view}]`)?.click();
    for (const k of controls) if (saved[k] != null) $<HTMLInputElement>(k).value = saved[k];
    for (const k of checks) if (saved[k] != null) $<HTMLInputElement>(k).checked = saved[k];
    if (saved.fea) for (const f of FEATURES) if (f.tag in saved.fea) state[f.tag] = !!saved.fea[f.tag];
  }
  const viewValue = () => document.querySelector<HTMLInputElement>('input[name=view]:checked')!.value;

  // A shared link wins over saved settings: #vtex-… for the features, ?tekst=… for the text.
  // While ?tekst= is in the address it follows the text, so copying the address bar stays exact.
  restore();
  if (location.hash.toLowerCase().startsWith('#vtex')) Object.assign(state, decode(location.hash).state);
  const linkedText = new URLSearchParams(location.search).get('tekst');
  const TEXT_IN_URL = linkedText != null;
  if (TEXT_IN_URL) text.value = linkedText;
  applyState(state);

  // ---------- rendering
  function guideLines(): HTMLElement {
    const g = document.createElement('div');
    g.className = 'guides';
    for (const [cls, units] of [['asc', ASC - ASCENDER], ['xh', ASC - XH], ['base', ASC], ['desc', ASC + DESCENDER]] as const) {
      const i = document.createElement('i');
      i.className = cls;
      i.style.top = `calc(var(--size) * ${units / UPM})`;
      g.appendChild(i);
    }
    return g;
  }
  function makeRow(line: string, which: ('orig' | 'new')[], label?: { text: string; color: string }): HTMLElement {
    const row = document.createElement('div');
    row.className = 'row';
    row.appendChild(guideLines());
    for (const w of which) {
      const span = document.createElement('div');
      span.className = 'ink ' + w;
      const shown = w === 'orig' && $<HTMLInputElement>('ghost').checked ? toBase(line) : line;
      span.textContent = shown.length ? shown : ' ';
      row.appendChild(span);
    }
    if (label) {
      const l = document.createElement('div');
      l.className = 'row-label';
      l.textContent = label.text;
      l.style.color = label.color;
      row.appendChild(l);
      row.classList.add(which[0] === 'orig' ? 'only-orig' : 'only-new');
    }
    return row;
  }

  function render() {
    const size = +$<HTMLInputElement>('size').value;
    $('sizeOut').textContent = `${size} px`;
    $('opOrigOut').textContent = `${$<HTMLInputElement>('opOrig').value}%`;
    $('opNewOut').textContent = `${$<HTMLInputElement>('opNew').value}%`;
    const s = paper.style;
    s.setProperty('--size', `${size}px`);
    s.setProperty('--line-h', `${(ASC + DESC) / UPM}`);
    s.setProperty('--row-h', `calc(${size}px * ${(ASC + DESC) / UPM})`);
    s.setProperty('--row-gap', `${Math.round(size * 0.25)}px`);
    s.setProperty('--margin-x', '96px');
    s.setProperty('--c-orig', $<HTMLInputElement>('colOrig').value);
    s.setProperty('--c-new', $<HTMLInputElement>('colNew').value);
    s.setProperty('--o-orig', String(+$<HTMLInputElement>('opOrig').value / 100));
    s.setProperty('--o-new', String(+$<HTMLInputElement>('opNew').value / 100));
    $('ctlOrig').style.setProperty('--swatch', $<HTMLInputElement>('colOrig').value);
    $('ctlNew').style.setProperty('--swatch', $<HTMLInputElement>('colNew').value);
    s.setProperty('--fea', cssFeatures(state));
    s.setProperty('--kerning', state.kern ? 'normal' : 'none');
    paper.classList.toggle('blend', $<HTMLInputElement>('blend').checked);
    paper.classList.toggle('no-guides', !$<HTMLInputElement>('guides').checked);
    paper.classList.toggle('hide-orig', !$<HTMLInputElement>('showOrig').checked);
    paper.classList.toggle('hide-new', !$<HTMLInputElement>('showNew').checked);
    for (const f of FEATURES) $(`row_${f.tag}`)?.classList.toggle('on', !!state[f.tag]);

    $<HTMLInputElement>('cfgOut').value = encode(state);
    const q = TEXT_IN_URL ? `?tekst=${encodeURIComponent(text.value)}` : '';
    try { history.replaceState(null, '', location.pathname + q + '#' + linkCode(state)); } catch { /* not allowed here */ }
    const st = $('cfgStatus');
    if (!st.dataset.sticky) {
      const warn = warnings(state);
      st.className = 'status' + (warn.length ? ' err' : '');
      st.textContent = warn.join(' ');
    }

    rows.replaceChildren();
    if (!text.value.trim()) {
      const h = document.createElement('div');
      h.className = 'empty-hint';
      h.textContent = 'Typ tekst in het vak rechts om de twee lettertypes te vergelijken.';
      rows.appendChild(h);
    } else {
      const view = viewValue();
      for (const line of text.value.split('\n')) {
        if (view === 'overlay') {
          rows.appendChild(makeRow(line, ['orig', 'new']));
        } else {
          const a = makeRow(line, ['orig'], { text: 'Origineel', color: $<HTMLInputElement>('colOrig').value });
          a.classList.add('stack-first');
          rows.appendChild(a);
          rows.appendChild(makeRow(line, ['new'], { text: 'Nieuw', color: $<HTMLInputElement>('colNew').value }));
        }
      }
    }
    persist();
  }

  function flash(msg: string, cls: 'ok' | 'err') {
    const st = $('cfgStatus');
    st.className = `status ${cls}`;
    st.textContent = msg;
    st.dataset.sticky = '1';
    setTimeout(() => { delete st.dataset.sticky; render(); }, 4000);
  }

  // ---------- events
  for (const cb of featureBoxes) cb.addEventListener('change', () => { state[cb.dataset.tag!] = cb.checked; render(); });
  const panel = document.querySelector<HTMLElement>('.panel')!;
  for (const ev of ['input', 'change']) panel.addEventListener(ev, (e) => { if (!(e.target as HTMLElement).closest('.config')) render(); });
  document.querySelectorAll<HTMLElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => { text.value = PRESETS[b.dataset.preset!]; render(); }));
  $('cfgCopy').addEventListener('click', () => {
    const out = $<HTMLInputElement>('cfgOut');
    navigator.clipboard.writeText(out.value)
      .then(() => flash(`Gekopieerd: ${out.value}`, 'ok'))
      .catch(() => { out.focus(); out.select(); flash('Kopiëren lukt hier niet automatisch. De code is geselecteerd: kopieer ze met Ctrl/Cmd+C.', 'err'); });
  });
  $('cfgReset').addEventListener('click', () => { applyState(DEFAULTS); render(); flash('Alles staat weer standaard.', 'ok'); });
  const doApply = () => {
    const { state: next, unknown } = decode($<HTMLInputElement>('cfgIn').value);
    applyState(next);
    render();
    flash(unknown.length ? `Toegepast. Onbekend en genegeerd: ${unknown.join(', ')}` : `Toegepast: ${encode(state)}`, unknown.length ? 'err' : 'ok');
  };
  $('cfgApply').addEventListener('click', doApply);
  $('cfgIn').addEventListener('keydown', (e) => { if (e.key === 'Enter') doApply(); });
  window.addEventListener('hashchange', () => {
    if (location.hash.toLowerCase().startsWith('#vtex') && location.hash.slice(1) !== linkCode(state)) {
      applyState(decode(location.hash).state);
      render();
    }
  });

  // ---------- feedback: the new font on writing lines, with the text in the link
  onFeedback(() => {
    const lines = text.value.replace(/\s+$/, '').split('\n').slice(0, 8);
    const snapState = { ...state };
    const link = new URL(location.href);
    link.search = `?tekst=${encodeURIComponent([...text.value].slice(0, 200).join(''))}`;
    return {
      template: 'algemeen.yml',
      title: `[Opmerking] ${lines[0].length > 40 ? lines[0].slice(0, 39) + '…' : lines[0]}`,
      fields: { tekst: text.value, instellingen: encode(state), link: publicLink(link) },
      snapshot: async () => renderLines(await loadFont(), lines.map((t) => ({ text: t, state: snapState })), { size: 90, caption: `${versionText()} · ${encode(snapState)}` }),
    };
  });

  render();
</script>

<style is:global>
  /* Writing sheet + feature table on the left, sticky settings on the right; one column on phones. */
  .proberen {
    --ui-warn: #9A5B00; --ui-err: #B42318; --ui-ok: #1D7A3A;
    display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: 20px;
    padding-block: 20px; padding-inline: max(16px, env(safe-area-inset-left, 0px));
    max-width: 1600px; margin: 0 auto;
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .proberen { --ui-warn: #E3B341; --ui-err: #FF8A80; --ui-ok: #5FD38A; } }
  @media (max-width: 900px) { .proberen { grid-template-columns: minmax(0, 1fr); } }
  .proberen .main { display: grid; gap: 20px; min-width: 0; align-content: start; }

  /* the sheet (always paper, also in dark mode) */
  .proberen .paper { background: var(--paper); border-radius: 6px; box-shadow: 0 1px 0 rgba(27, 36, 51, .08), 0 8px 24px -12px rgba(27, 36, 51, .25); overflow-x: auto; position: relative; min-height: 50vh; }
  .proberen .paper-inner { position: relative; padding: 24px 32px 48px 0; min-width: max-content; }
  .proberen .margin-rule { position: absolute; top: 0; bottom: 0; left: var(--margin-x); width: 2px; background: var(--margin); opacity: .75; }
  .proberen .row { position: relative; height: var(--row-h); margin-bottom: var(--row-gap); }
  .proberen .row.stack-first { margin-bottom: calc(var(--row-gap) * .25); }
  .proberen .guides { position: absolute; left: 0; right: -32px; top: 0; height: 100%; pointer-events: none; }
  .proberen .guides i { position: absolute; left: 0; right: 0; height: 0; border-top: 1px solid var(--rule); }
  .proberen .guides i.base { border-top: 1.5px solid var(--rule-strong); }
  .proberen .guides i.xh { border-top-style: dashed; }
  .proberen .paper.no-guides .guides { display: none; }
  .proberen .row-label { position: absolute; left: 10px; top: 0; height: 100%; width: calc(var(--margin-x) - 18px); display: flex; align-items: center; justify-content: flex-end; font-size: 13px; font-weight: 700; text-align: right; line-height: 1.2; }
  .proberen .ink { position: absolute; left: calc(var(--margin-x) + 20px); top: 0; font-size: var(--size); line-height: var(--line-h); white-space: pre; font-feature-settings: var(--fea); font-kerning: var(--kerning); font-synthesis: none; }
  .proberen .ink.orig { font-family: "Cogncur", sans-serif; color: var(--c-orig); opacity: var(--o-orig); }
  .proberen .ink.new { font-family: "Vtex", sans-serif; color: var(--c-new); opacity: var(--o-new); }
  .proberen .paper.blend .ink { mix-blend-mode: multiply; }
  .proberen .paper.hide-orig .ink.orig, .proberen .paper.hide-orig .row.only-orig { display: none; }
  .proberen .paper.hide-new .ink.new, .proberen .paper.hide-new .row.only-new { display: none; }
  .proberen .empty-hint { position: absolute; left: calc(var(--margin-x) + 20px); top: 32px; color: #5B6577; font-size: 18px; }

  /* feature table */
  .proberen .features { background: var(--ui-panel); border: 1px solid var(--ui-line); border-radius: 6px; padding: 16px; min-width: 0; }
  .proberen .features h2 { font-size: 20px; margin: 0 0 4px; text-wrap: balance; }
  .proberen .features .intro { color: var(--ui-muted); margin: 0 0 12px; max-width: 70ch; }
  .proberen .table-wrap { overflow-x: auto; }
  .proberen table.fea { border-collapse: collapse; width: 100%; min-width: 720px; }
  .proberen table.fea th, .proberen table.fea td { text-align: left; vertical-align: middle; padding: 8px 10px; border-bottom: 1px solid var(--ui-line); }
  .proberen table.fea thead th { font-size: 13px; color: var(--ui-muted); font-weight: 700; }
  .proberen table.fea tbody th.group { font-size: 14px; letter-spacing: .02em; padding-top: 18px; color: var(--ui-fg); border-bottom: 2px solid var(--ui-line); }
  .proberen table.fea tbody th.group small { font-weight: 400; color: var(--ui-muted); letter-spacing: 0; }
  .proberen table.fea tr.on td { background: color-mix(in srgb, var(--ui-focus) 9%, transparent); }
  .proberen td.tog { width: 44px; }
  .proberen td.tog input { width: 20px; height: 20px; accent-color: var(--ui-focus); }
  .proberen td.code code { font: 13px var(--font-code); white-space: nowrap; }
  .proberen td.what strong { display: block; }
  .proberen td.what span { color: var(--ui-muted); font-size: 14px; }
  .proberen td.what em { display: block; font-style: normal; font-size: 13px; color: var(--ui-warn); margin-top: 2px; }
  .proberen td.ex { white-space: nowrap; }
  .proberen .sample { display: inline-block; font-family: "Vtex", sans-serif; font-size: 30px; line-height: 1.25; color: var(--paper-ink); background: var(--paper); border-radius: 4px; padding: 0 8px; font-synthesis: none; }
  .proberen .sample.after { color: #B42318; }
