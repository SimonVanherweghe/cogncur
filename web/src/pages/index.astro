---
import Base from '../layouts/Base.astro';
import { REPO_URL } from '../lib/build';
import { buildFor } from '../lib/version-data';
import { DEFAULT_SLUG, LATEST } from '../lib/versions';
import { page } from '../lib/url';

const BUILD = buildFor(DEFAULT_SLUG);

const c = BUILD.counts;
const facts: [string, string][] = [
  ['Versie', LATEST ? `${LATEST.version} (de nieuwste)` : `${BUILD.version} (nog in ontwikkeling, er is nog geen versie uitgebracht)`],
  ['Gemaakt op', BUILD.date],
  ['Code', BUILD.commit],
  ['Tekens', `${c.total}: ${c.origineel} origineel, ${c.samengesteld} samengesteld, ${c.nieuw + c.schets} nieuw (${c.schets} nog als schets)`],
];
const cards: [string, string, string][] = [
  ['tekens', 'Alle tekens', 'Elke letter, elk cijfer en elk leesteken, met waar het vandaan komt.'],
  ['verbindingen', 'Verbindingen', 'Hoe elke letter aan de volgende hangt, in een grote tabel.'],
  ['proberen', 'Proberen', 'Typ je eigen tekst en vergelijk met het originele Cogncur.'],
  ['letters', 'Letters schrijven', 'De schrijfvolgorde van elke letter, zoals ze in het originele Cogncur getekend zijn.'],
  ['schrijven', 'Woorden schrijven', 'Zie hoe de pen een woord schrijft, in één beweging.'],
  ['versies', 'Versies', 'Wat er in elke versie beslist en veranderd is, en downloads.'],
];
---
<Base title="Cogncur voor Google Fonts" current="index"
      description="De nieuwste versie van Cogncur, een schrijfletter om te leren schrijven, op weg naar Google Fonts. Bekijk alle tekens en geef feedback.">
  <main class="page">
    <header class="page-head">
      <h1>Cogncur voor Google Fonts</h1>
      <p>Cogncur is een schrijfletter van Liesbeth Flobbe, gemaakt om te leren schrijven: de letters verbinden vanzelf, zoals met de hand. We maken er een versie van voor Google Fonts, zodat iedereen ze gratis kan gebruiken in Google Docs. Op deze website zie je altijd de nieuwste versie.</p>
    </header>

    <div class="hero" aria-label="Voorbeeld">Leren schrijven in de klas</div>

    <div class="cards">
      {cards.map(([id, title, text]) => (
        <a class="card" href={page(id)}><h3>{title}</h3><p>{text}</p></a>
      ))}
    </div>

    <section class="card prose">
      <h2>Zo geef je feedback</h2>
      <ol class="steps">
        <li>Zoek het teken, de verbinding of het woord waar iets aan schort.</li>
        <li>Klik op <strong>Feedback</strong>. De website maakt een afbeelding van wat je ziet en kopieert ze.</li>
        <li>Klik op <strong>Formulier openen op GitHub</strong>. Het teken, de instellingen, de versie en een link zijn al ingevuld.</li>
        <li>Plak de afbeelding met <kbd>Cmd</kbd>+<kbd>V</kbd> of <kbd>Ctrl</kbd>+<kbd>V</kbd>, schrijf wat je ziet en klik op <em>Create</em>.</li>
      </ol>
      <p class="hint">Je hebt een (gratis) GitHub-account nodig. Over grotere keuzes, zoals welke lettervormen standaard worden, stemmen we in de <a href={`${REPO_URL}/issues?q=is%3Aopen+label%3Abeslissing`} target="_blank" rel="noopener">open vragen</a>.</p>
    </section>

    {LATEST && (
      <section class="card prose" style="margin-top: 20px">
        <h2>Wat is er nieuw in versie {LATEST.version}?</h2>
        {LATEST.notes.length > 0
          ? <ul>{LATEST.notes.slice(0, 8).map((n) => <li><a href={`${REPO_URL}/issues/${n.number}`} target="_blank" rel="noopener">#{n.number}</a> {n.title}</li>)}</ul>
          : <p class="hint">Geen afgesloten vragen in deze versie.</p>}
        <p><a href={page('versies')}>Alle versies</a></p>
      </section>
    )}

    <section class="prose" style="margin-top: 20px">
      <h2>Deze versie</h2>
      <dl class="facts">
        {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
        <dt>Broncode</dt><dd><a href={REPO_URL}>{REPO_URL.replace('https://', '')}</a></dd>
      </dl>
    </section>
  </main>
</Base>
